# Production configuration for the Django backend.
#
# On the server: copy this file to ".env" (same folder as manage.py) and fill in
# the real values. The real .env is git-ignored and must never be committed.
#
# Generate a fresh SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=paste-a-freshly-generated-50-character-secret-key-here

# Must be False in production.
DEBUG=False

# The site's hostname(s), comma-separated. Host only, no scheme/slash.
ALLOWED_HOSTS=kanmind.svenhaase.de

# Frontend origins allowed to call this API from another origin. Not needed when
# frontend and API are served from the same domain.
CORS_ALLOWED_ORIGINS=

# Origins trusted for the Django admin login form over HTTPS.
CSRF_TRUSTED_ORIGINS=https://kanmind.svenhaase.de
